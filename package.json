{
  "name": "@joinrh/sanitize-html-esm",
  "version": "2.17.9",
  "description": "Clean up user-submitted HTML, preserving allowlisted elements and allowlisted attributes on a per-element basis. ESM fork of apostrophecms/sanitize-html.",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "npm run lint && mocha",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfranzon/sanitize-html.git"
  },
  "homepage": "https://github.com/luizfranzon/sanitize-html#readme",
  "keywords": [
    "html",
    "parser",
    "sanitizer",
    "sanitize"
  ],
  "author": "Apostrophe Technologies, Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "postcss": "^8.3.11"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-apostrophe": "^6.0.2",
    "mocha": "^11.7.5",
    "sinon": "^9.0.2",
    "typescript": "^5.7.0"
  },
  "apostropheTestConfig": {
    "requiresMongo": false
  }
}
