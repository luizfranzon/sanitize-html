{
  "name": "sanitize-html-esm",
  "version": "2.17.9",
  "description": "Clean up user-submitted HTML, preserving allowlisted elements and allowlisted attributes on a per-element basis. ESM fork of apostrophecms/sanitize-html.",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib"
  ],
  "scripts": {
    "test": "npm run lint && mocha",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit index.d.ts",
    "benchmark": "node benchmark/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizfranzon/sanitize-html.git"
  },
  "homepage": "https://github.com/luizfranzon/sanitize-html#readme",
  "keywords": [
    "html",
    "parser",
    "sanitizer",
    "sanitize"
  ],
  "author": "Apostrophe Technologies, Inc.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "apostropheTestConfig": {
    "requiresMongo": false
  }
}
